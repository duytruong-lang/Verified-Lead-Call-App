# Template only. Copy this file to a private env file after replacing every placeholder.
# Never commit the private file or use these placeholder values in a deployed project.
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Do not add variables beginning with SUPABASE_ to custom secrets.

PUBLIC_APP_URL=https://YOUR-CLOUDFLARE-PAGES-DOMAIN
APP_ORIGIN=https://YOUR-CLOUDFLARE-PAGES-DOMAIN
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SHARE_ENCRYPTION_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
TEAM_LINK_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES
TEAM_LINK_TTL_SECONDS=3600

# Optional. Leave unset until an authorized pilot Google Sheet and service account exist.
# Store the service account JSON only in Supabase Edge Function secrets.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
